      <div class="empty-state">
        <h3>📚 और पढ़ाई करनी है?</h3>
        <p>
          Books, Videos, Question Bank और बाकी features Mission Lakshya
          के Home page से खोल सकते हो।
        </p>

        <a
          href="../index.html"
          class="yt-btn"
          style="display:inline-block;text-decoration:none;"
        >
          ← Back to Home
        </a>
      </div>
    </section>

  </main>


  <script src="../script.js" defer></script>

  <script>

    function getYouTubeId(url) {

      if (!url) return null;

      try {

        const value = url.trim();

        const patterns = [
          /youtube\.com\/watch\?v=([^&]+)/,
          /youtu\.be\/([^?&]+)/,
          /youtube\.com\/shorts\/([^?&]+)/,
          /youtube\.com\/embed\/([^?&]+)/
        ];

        for (const pattern of patterns) {

          const match = value.match(pattern);

          if (match) {
            return match[1];
          }

        }

      } catch (error) {
        console.error(error);
      }

      return null;
    }


    function openYouTube() {

      const input = document.getElementById("youtubeUrl");

      const url = input.value.trim();

      if (!url) {

        alert("पहले YouTube URL डालें।");

        return;
      }

      const videoId = getYouTubeId(url);

      if (!videoId) {

        alert("Valid YouTube video URL डालें।");

        return;
      }

      loadVideo(videoId, "YouTube Video");

      document.querySelector(".viewer-box")
        .scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
    }


    function loadVideo(videoId, title) {

      const frame = document.getElementById("youtubeFrame");

      const viewerTitle = document.getElementById("viewerTitle");

      frame.src =
        "https://www.youtube.com/embed/" +
        encodeURIComponent(videoId) +
        "?rel=0";

      viewerTitle.textContent =
        title || "YouTube Video Viewer";
    }


    function clearYouTube() {

      document.getElementById("youtubeUrl").value = "";

      closeViewer();
    }


    function closeViewer() {

      document.getElementById("youtubeFrame").src =
        "about:blank";

      document.getElementById("viewerTitle").textContent =
        "YouTube Video Viewer";
    }


    function searchYouTube(query) {

      const url =
        "https://www.youtube.com/results?search_query=" +
        encodeURIComponent(query);

      window.open(url, "_blank", "noopener");

    }


    function loadChannel(channel) {

      searchYouTube(channel + " NEET lectures");
    }

  </script>

