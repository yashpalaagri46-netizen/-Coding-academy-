body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    text-align: center;
    background: #f2f5ff;
}

h1 {
    margin-top: 100px;
    font-size: 40px;
}

p {
    font-size: 20px;
}

button {
    padding: 14px 30px;
    font-size: 18px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}
